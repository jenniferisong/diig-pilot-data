# This is the website you will open manually in your own Edge window before the script starts searching.
START_URL = "https://congressional-proquest-com.proxy.lib.duke.edu/profiles/gis/search/basic/basicsearch"

# This is the local debugging address that Edge exposes when you start it
# with --remote-debugging-port=9222.
EDGE_DEBUG_URL = "http://127.0.0.1:9222"

# Output Excel file name.
OUTPUT_FILE = "output_with_pdfs.xlsx"

# Folder where downloaded PDFs will be saved.
PDF_DOWNLOAD_FOLDER = "downloaded_pdfs"

# Output column for the downloaded complete-replica PDF path.
PDF_LINK_COLUMN = "pdf_link"

# Some complete hearing replicas are large and slow through the Duke proxy.
PDF_DOWNLOAD_TIMEOUT_MS = 600000
DOWNLOAD_EVENT_TIMEOUT_MS = 30000


def find_excel_file() -> Path:
    """
    Find the first Excel file in the current folder.
    We ignore the output file so we do not accidentally re-read it later.
    """
    current_folder = Path(".")
    excel_files = [
        path
        for path in current_folder.iterdir()
        if path.is_file()
        and path.suffix.lower() in [".xls", ".xlsx"]
        and path.name != OUTPUT_FILE
    ]

    if not excel_files:
        raise FileNotFoundError("No Excel file (.xls or .xlsx) was found in this folder.")

    if len(excel_files) > 1:
        print("More than one Excel file was found.")
        print(f"Using the first one: {excel_files[0].name}")

    return excel_files[0]


def parse_args():
    """
    Read optional command line row limits.
    Excel row 1 is the header, so Excel row 2 is the first data row.
    """
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--start-excel-row",
        type=int,
        default=2,
        help="First Excel row to process. Row 2 is the first data row.",
    )
    parser.add_argument(
        "--end-excel-row",
        type=int,
        default=None,
        help="Last Excel row to process. Leave blank to process through the end.",
    )
    parser.add_argument(
        "--batch-size",
        type=int,
        default=None,
        help=(
            "Number of Excel rows to process starting at --start-excel-row. "
            "For example, --start-excel-row 6 --batch-size 10 processes rows 6-15."
        ),
    )
    parser.add_argument(
        "--save-every",
        type=int,
        default=1,
        help=(
            "Save after this many processed rows. Use a larger number for faster batches; "
            "1 is safest because it saves after every row."
        ),
    )
    return parser.parse_args()


def load_excel(excel_path: Path) -> pd.DataFrame:
    """
    Read the Excel file into a pandas DataFrame.

    Important:
    - .xlsx files usually work with openpyxl
    - .xls files usually need xlrd installed
    """
    print(f"Reading Excel file: {excel_path.name}")

    if excel_path.suffix.lower() == ".xls":
        return pd.read_excel(excel_path, engine="xlrd")

    return pd.read_excel(excel_path)


def carry_forward_existing_output(df: pd.DataFrame) -> pd.DataFrame:
    """
    Keep permalink/pdf_link values from a previous output workbook.
    This prevents a row-limited rerun from blanking rows that were already done.
    """
    output_path = Path(OUTPUT_FILE)
    if not output_path.exists():
        return df

    try:
        existing_df = pd.read_excel(output_path)
    except Exception as exc:
        print(f"Could not read existing {OUTPUT_FILE} for carry-forward: {exc}")
        return df

    for column in [PDF_LINK_COLUMN, "permalink"]:
        if column not in existing_df.columns:
            continue
        if column not in df.columns:
            df[column] = ""

        row_count = min(len(df), len(existing_df))
        for index in range(row_count):
            existing_value = existing_df.at[index, column]
            if pd.isna(existing_value):
                continue

            existing_text = str(existing_value).strip()
            if existing_text and existing_text.lower() != "nan":
                df.at[index, column] = existing_text

    return df


def find_uid_column(df: pd.DataFrame) -> str:
    """
    Automatically find the UID column.

    Simple rules:
    - First try exact matches like UID or uid
    - Then try exact matches like source
    - Then try any column name that contains the word uid
    """
    columns = list(df.columns)
    normalized_map = {
        column: str(column).strip().lower().replace(" ", "").replace("_", "")
        for column in columns
    }

    for column in columns:
        if normalized_map[column] == "uid":
            return column

    for column in columns:
        if normalized_map[column] == "source":
            return column

    for column in columns:
        normalized = normalized_map[column]
        if "uid" in normalized or "source" in normalized:
            return column

    raise ValueError(
        "Could not find a UID/source column automatically.\n"
        f"Columns found: {columns}"
    )


def clean_uid(value) -> str:
    """
    Turn a UID cell value into a clean string.
    Blank values become an empty string.
    """
    if pd.isna(value):
        return ""

    text = str(value).strip()
    if text.lower() == "nan":
        return ""

    return text


def make_safe_filename(text: str) -> str:
    """
    Remove characters that are not safe in Windows file names.
    """
    safe = re.sub(r'[<>:"/\\\\|?*]', "_", text)
    safe = safe.strip().strip(".")
    return safe or "downloaded_file"


def make_unique_path(folder: Path, filename: str) -> Path:
    """
    Return a path that does not overwrite an existing file.
    """
    candidate = folder / filename
    if not candidate.exists():
        return candidate

    stem = candidate.stem
    suffix = candidate.suffix
    counter = 2

    while True:
        candidate = folder / f"{stem}_{counter}{suffix}"
        if not candidate.exists():
            return candidate
        counter += 1


def save_output_excel(df: pd.DataFrame):
    """
    Save the output workbook and make local PDF paths clickable in pdf_link.
    """
    df.to_excel(OUTPUT_FILE, index=False)

    if PDF_LINK_COLUMN not in df.columns:
        return

    pdf_column_number = list(df.columns).index(PDF_LINK_COLUMN) + 1
    workbook = load_workbook(OUTPUT_FILE)
    sheet = workbook.active

    for row_number in range(2, sheet.max_row + 1):
        cell = sheet.cell(row=row_number, column=pdf_column_number)
        value = str(cell.value or "").strip()
        if not value or value.lower() == "nan":
            continue

        pdf_path = Path(value)
        if pdf_path.exists():
            cell.hyperlink = pdf_path.resolve().as_uri()
            cell.style = "Hyperlink"

    workbook.save(OUTPUT_FILE)
    workbook.close()


